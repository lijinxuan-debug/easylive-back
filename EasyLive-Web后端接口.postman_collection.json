                      "value": "5",
                      "type": "text"
                    },
                    {
                      "key": "checkCodeKey",
                      "value": "{{checkCodeKey}}",
                      "type": "text"
                    }
                  ]
                },
                "url": {
                  "raw": "{{base_url}}/account/register",
                  "host": ["{{base_url}}"],
                  "path": ["account", "register"]
