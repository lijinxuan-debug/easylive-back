              "raw": "{{base_url}}/account/checkCode",
              "host": ["{{base_url}}"],
              "path": ["account", "checkCode"]
            },
            "description": "生成算术验证码，返回 Base64 图片和验证码 Key"
          },
          "response": [
            {
              "name": "成功响应",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/account/checkCode",
                  "host": ["{{base_url}}"],
                  "path": ["account", "checkCode"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [],
              "body": "{\n  \"code\": 200,\n  \"message\": \"success\",\n  \"data\": {\n    \"checkCode\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUg...\",\n    \"checkCodeKey\": \"check_code_key_xxx\"\n  }\n}"
            }
          ]
        },
        {
